@startuml dac-03-reporte-cu03
title Diagrama de actividad - CU-03 Revisar el reporte semanal de rotación\nProyecto Grupo 04 - Sistema de registro de ventas

|Propietario|
start
:Abrir el reporte semanal de rotación;

|Sistema|
repeat
  if (¿Producto con 4 semanas de datos?) then (sí)
    :Calcular la rotación de las últimas 8 semanas;
    if (¿Vendió menos del 25% del promedio\nde los demás productos, 4 semanas seguidas?) then (sí)
      :Marcar el producto como de rotación baja;
    else (no)
    endif
  else (no)
    :Marcar "menos de 4 semanas de datos";
  endif
repeat while (¿Quedan productos por evaluar?) is (sí) not (no)
:Mostrar el reporte completo;

|Propietario|
:Revisar el reporte;
if (¿Decide descontinuar algún producto marcado?) then (sí)
  |Sistema|
  :Registrar la decisión junto con\nel reporte de 8 semanas que la respalda;
  stop
else (no)
  :No se registra ninguna decisión;
  stop
endif

@enduml
